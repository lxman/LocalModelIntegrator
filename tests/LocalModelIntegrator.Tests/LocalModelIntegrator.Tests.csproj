<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>exe</OutputType>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>LocalModelIntegrator.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The VSIX project cannot be referenced from a plain test project (VS SDK build
         targets), so the transport-format-free sources under test are compile-linked. -->
    <Compile Include="..\..\src\LocalModelIntegrator\Models\ChatMessage.cs" Link="Models\ChatMessage.cs" />
    <Compile Include="..\..\src\LocalModelIntegrator\Services\ChatMessageNormalizer.cs" Link="Services\ChatMessageNormalizer.cs" />
    <Compile Include="..\..\src\LocalModelIntegrator\ToolWindows\MarkdownDocumentRenderer.cs" Link="ToolWindows\MarkdownDocumentRenderer.cs" />
    <Compile Include="..\..\src\LocalModelIntegrator\ToolWindows\MarkdownContent.cs" Link="ToolWindows\MarkdownContent.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
