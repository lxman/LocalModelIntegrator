<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>

  <Commands package="guidPackage">
    <Groups>
      <!-- Place our group under View > Other Windows. The parent must be the submenu (IDM),
           not a group (IDG) - parenting a group inside IDG_VS_WNDO_OTRWNDWS1 does not render. -->
      <Group guid="guidCommandSet" id="MyMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CSCD_WINDOWS"/>
      </Group>

      <!-- Anchor group on the code editor right-click menu (ReSharper does not hijack this). -->
      <Group guid="guidCommandSet" id="EditorCtxGroup" priority="0x0700">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>

      <!-- Items inside the flyout submenu. -->
      <Group guid="guidCommandSet" id="SubMenuGroup" priority="0x0100">
        <Parent guid="guidCommandSet" id="LocalModelSubMenu"/>
      </Group>
    </Groups>

    <Menus>
      <Menu guid="guidCommandSet" id="LocalModelSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidCommandSet" id="EditorCtxGroup"/>
        <!-- Required for the UICONTEXT_SolutionExists VisibilityConstraint to take effect: without
             DynamicVisibility the constraint is ignored and the flyout always shows. DefaultInvisible
             makes "hidden" the starting state, so it only appears when the context activates. -->
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Local Model AI</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Buttons>
      <Button guid="guidCommandSet" id="cmdidOpenChatWindow" priority="0x0100" type="Button">
        <Parent guid="guidCommandSet" id="MyMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="CommentGroup"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Local Model Integrator</ButtonText>
          <CommandName>LocalModelIntegrator</CommandName>
          <ToolTipText>Open Local Model Integrator chat window</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidCommandSet" id="cmdidClearConversation" priority="0x0101" type="Button">
        <Parent guid="guidCommandSet" id="MyMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="ClearWindowContent"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Clear Conversation</ButtonText>
          <CommandName>LocalModelIntegratorClear</CommandName>
          <ToolTipText>Clear the current chat conversation</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidCommandSet" id="cmdidSendFileToChat" priority="0x0102" type="Button">
        <Parent guid="guidCommandSet" id="MyMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="SendToBack"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Send File to Chat</ButtonText>
          <CommandName>LocalModelIntegratorSendFile</CommandName>
          <ToolTipText>Send the active editor file to the chat</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidCommandSet" id="cmdidExplainCode" priority="0x0100" type="Button">
        <Parent guid="guidCommandSet" id="SubMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="CommentGroup"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Explain</ButtonText>
          <ToolTipText>Explain the selected code with the local model</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidCommandSet" id="cmdidRefactorCode" priority="0x0101" type="Button">
        <Parent guid="guidCommandSet" id="SubMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="CommentGroup"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Refactor</ButtonText>
          <ToolTipText>Suggest a refactoring of the selected code</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidCommandSet" id="cmdidGenerateTests" priority="0x0102" type="Button">
        <Parent guid="guidCommandSet" id="SubMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="CommentGroup"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Generate Tests</ButtonText>
          <ToolTipText>Generate unit tests for the selected code</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidCommandSet" id="cmdidAddDocComments" priority="0x0103" type="Button">
        <Parent guid="guidCommandSet" id="SubMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="CommentGroup"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Add Doc Comments</ButtonText>
          <ToolTipText>Add XML doc comments to the selected code</ToolTipText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- Hide the editor "Local Model AI" flyout unless a solution is open. The shell evaluates this
       WITHOUT loading the package, so it works even before the package auto-loads (which only
       happens once a solution exists). The runtime BeforeQueryStatus handler then refines this with
       the precise, FullName-aware solution check once the package is actually loaded. -->
  <VisibilityConstraints>
    <VisibilityItem guid="guidCommandSet" id="LocalModelSubMenu" context="UICONTEXT_SolutionExists"/>
  </VisibilityConstraints>

  <Symbols>
    <!-- Package GUID -->
    <GuidSymbol name="guidPackage" value="{9719D000-2E35-4BBA-96B2-2454631E5CDC}"/>

    <!-- Command set GUID - matches OpenChatWindowCommand.CommandSet -->
    <GuidSymbol name="guidCommandSet" value="{C3D4E5F6-A7B8-4C9D-8E0F-1A2B3C4D5E6F}">
      <IDSymbol name="MyMenuGroup"           value="0x1020"/>
      <IDSymbol name="EditorCtxGroup"        value="0x1030"/>
      <IDSymbol name="LocalModelSubMenu"     value="0x1031"/>
      <IDSymbol name="SubMenuGroup"          value="0x1032"/>
      <IDSymbol name="cmdidOpenChatWindow"   value="0x0100"/>
      <IDSymbol name="cmdidClearConversation" value="0x0101"/>
      <IDSymbol name="cmdidSendFileToChat"   value="0x0102"/>
      <IDSymbol name="cmdidExplainCode"      value="0x0110"/>
      <IDSymbol name="cmdidRefactorCode"     value="0x0111"/>
      <IDSymbol name="cmdidGenerateTests"    value="0x0112"/>
      <IDSymbol name="cmdidAddDocComments"   value="0x0113"/>
    </GuidSymbol>
  </Symbols>
</CommandTable>
