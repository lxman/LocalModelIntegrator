<UserControl x:Class="LocalModelIntegrator.ToolWindows.ChatWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:LocalModelIntegrator.ToolWindows"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="400"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalModelIntegrator;component/Styles/ChatStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="NormalMessageTemplate">
                <Border Margin="0,0,0,10" Padding="10" CornerRadius="5" BorderThickness="1"
                        Style="{StaticResource MessageBorderStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,5">
                            <Button Content="Copy" DockPanel.Dock="Right" Click="CopyButton_Click"
                                    Padding="6,1" FontSize="10" VerticalAlignment="Center"
                                    ToolTip="Copy this message to the clipboard"/>
                            <TextBlock Text="{Binding Role}"
                                       Style="{StaticResource RoleLabelStyle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding Content}"
                                 Style="{StaticResource SelectableContentStyle}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ThinkingMessageTemplate">
                <Grid Margin="0,0,0,10">
                    <!-- Base border (themed) holds the content. -->
                    <Border Padding="6" CornerRadius="5" BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarBorderBrushKey}}">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="{Binding Header}" Style="{StaticResource RoleLabelStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Expander.Header>
                            <TextBox Text="{Binding Content}"
                                     Margin="0,5,0,0"
                                     Style="{StaticResource SelectableContentStyle}"/>
                        </Expander>
                    </Border>
                    <!-- Themed accent border overlaid and opacity-pulsed. Click-through so the Expander still works. -->
                    <Border x:Name="ThinkingAccent" CornerRadius="5" BorderThickness="1"
                            IsHitTestVisible="False" Opacity="0"
                            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.AccentMediumBrushKey}}"/>
                </Grid>
                <DataTemplate.Triggers>
                    <!-- Gently cross-fade to the themed accent while the thinking bubble is still streaming. -->
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="ThinkingPulse">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThinkingAccent"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:1"
                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="ThinkingPulse"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="ToolMessageTemplate">
                <Border Margin="0,0,0,4" Padding="6,3" CornerRadius="3" BorderThickness="1"
                        Style="{StaticResource MessageBorderStyle}">
                    <TextBlock Style="{StaticResource ToolRowStyle}">
                        <Run Text="&#x1F527; "/><Run Text="{Binding Content}"/>
                    </TextBlock>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NoticeMessageTemplate">
                <Border Margin="0,0,0,10" Padding="8" CornerRadius="5" BorderThickness="1"
                        Background="{DynamicResource {x:Static vsui:InfoBarColors.InfoBarBackgroundBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static vsui:InfoBarColors.InfoBarBorderBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="Notice"
                                   Style="{StaticResource RoleLabelStyle}"
                                   Foreground="{DynamicResource {x:Static vsui:InfoBarColors.InfoBarBackgroundTextBrushKey}}"/>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource {x:Static vsui:InfoBarColors.InfoBarBackgroundTextBrushKey}}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                           Normal="{StaticResource NormalMessageTemplate}"
                                           Thinking="{StaticResource ThinkingMessageTemplate}"
                                           Tool="{StaticResource ToolMessageTemplate}"
                                           Notice="{StaticResource NoticeMessageTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarBorderBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="10">
            <DockPanel>
                <Button x:Name="ClearButton"
                        Content="Clear"
                        DockPanel.Dock="Right"
                        Padding="10,5"
                        Margin="5,0,0,0"/>
                <TextBlock Text="Local Model Integrator"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Endpoint disclosure banner: shown once per non-local endpoint until acknowledged. -->
        <Border Grid.Row="1" x:Name="EndpointBanner" Visibility="Collapsed"
                Padding="10,8" BorderThickness="0,0,0,1"
                Background="{DynamicResource {x:Static vsui:InfoBarColors.InfoBarBackgroundBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:InfoBarColors.InfoBarBorderBrushKey}}">
            <DockPanel>
                <Button x:Name="EndpointAckButton" Content="Acknowledge" DockPanel.Dock="Right"
                        Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="EndpointSettingsButton" Content="Settings…" DockPanel.Dock="Right"
                        Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="EndpointBannerText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static vsui:InfoBarColors.InfoBarBackgroundTextBrushKey}}"/>
            </DockPanel>
        </Border>

        <!-- Messages Area -->
        <ScrollViewer Grid.Row="2"
                      x:Name="MessagesScrollViewer"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesContainer" Margin="10"
                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}"/>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="3"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Endpoint chip: always-on "where the code you send goes" indicator. -->
                <Border x:Name="EndpointChip" Grid.Row="0" Margin="0,0,0,6" Padding="6,3"
                        CornerRadius="3" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left"
                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarBorderBrushKey}}"
                        ToolTip="Where the code you send is delivered. Click to change the endpoint in options.">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EndpointDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="EndpointChipText" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Border>

                <TextBox x:Name="InputTextBox"
                         Grid.Row="1"
                         MinHeight="60"
                         MaxHeight="200"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Padding="5"/>

                <DockPanel Grid.Row="2" Margin="0,5,0,0">
                    <Button x:Name="SendButton"
                            Content="Send"
                            Padding="15,5"
                            MinWidth="80"
                            DockPanel.Dock="Left"/>
                    <Button x:Name="StopButton"
                            Content="Stop"
                            Padding="15,5"
                            MinWidth="60"
                            Margin="5,0,0,0"
                            IsEnabled="False"
                            DockPanel.Dock="Left"
                            ToolTip="Cancel the in-progress request"/>
                    <TextBlock Text="Enter send · Shift+Enter newline · Ctrl+↑/↓ history"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <TextBlock x:Name="StatusText"
                               Text=""
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,5,0"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
